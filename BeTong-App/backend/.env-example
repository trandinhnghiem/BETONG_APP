# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION (SQL Server)
# ============================================
# For Local SQL Server / Azure SQL Database
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourPassword123
DB_NAME=AuditAppDB

# SSL/TLS Configuration
# Set to "true" for Azure SQL Database and AWS RDS
DB_ENCRYPT=false
# Set to "true" if using self-signed certificate or AWS RDS
DB_TRUST_SERVER_CERTIFICATE=true

# ============================================
# JWT AUTHENTICATION CONFIGURATION
# ============================================
# IMPORTANT: Change this to a strong random string in production!
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3002,http://localhost:3000

# ============================================
# CLOUDINARY CONFIGURATION (Optional)
# ============================================
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Backend sẽ tự tạo tài khoản admin nếu chưa tồn tại.
# Vui lòng đổi mật khẩu sau khi deploy production!
ADMIN_DEFAULT_USERNAME=adminxmtd
ADMIN_DEFAULT_PASSWORD=Admin@123
ADMIN_DEFAULT_FULLNAME=Quản trị viên XMTĐ
ADMIN_DEFAULT_EMAIL=admin@xmtd.com
ADMIN_DEFAULT_PHONE=+84 912 345 678

# ============================================
# CORS CONFIGURATION (Optional)
# ============================================
# Comma-separated list of allowed origins
# Example: CORS_ORIGIN=http://localhost:5173,https://yourdomain.com
# Leave empty to allow all origins (not recommended for production)
CORS_ORIGIN=

# ============================================
# RENDER DEPLOYMENT NOTES
# ============================================
# When deploying to Render:
# 1. Set NODE_ENV=production
# 2. Add all environment variables in Render dashboard
# 3. Render will automatically set PORT (you can remove PORT from env)
# 4. Make sure to set CORS_ORIGIN to your frontend URLs
# 5. Database connection string format for Render:
#    DB_SERVER=your-server.database.windows.net
#    DB_PORT=1433
#    DB_USER=your-username
#    DB_PASSWORD=your-password
#    DB_NAME=auditapp_db
#    DB_ENCRYPT=true
#    DB_TRUST_SERVER_CERTIFICATE=false
